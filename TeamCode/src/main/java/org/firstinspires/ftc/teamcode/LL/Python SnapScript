# runPipeline() is called every frame by Limelight's backend.
def runPipeline(image, llrobot):
    # llrobot = [100,40,250,300,2]
    img_hsv = cv2.cvtColor(image, cv2.COLOR_BGR2HSV)
    img_box = np.zeros_like(image)

    min_x = np.uint16(llrobot[0])
    min_y = np.uint16(llrobot[1])
    max_x = np.uint16(llrobot[2])
    max_y = np.uint16(llrobot[3])

    # img_box[min_y:max_y,min_x:max_x] = img_hsv[min_y:max_y,min_x:max_x]
    if np.int8(llrobot[4]) == 1:
        img_threshold = cv2.inRange(img_hsv, (160, 70, 70), (180, 255, 255)) + cv2.inRange(img_hsv, (0, 70, 70), (10, 255, 255))

    if np.int8(llrobot[4]) == 0:
        img_threshold = cv2.inRange(img_hsv, (100, 50, 50), (115, 255, 255))

    if np.int8(llrobot[4]) == 2:
        img_threshold = cv2.inRange(img_hsv, (20, 150, 150), (30, 255, 255))

    roi = img_threshold[min_y:max_y,min_x:max_x]
    contours, _ = cv2.findContours(roi,
    cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

    largestContour = np.array([[]])
    llpython = [0,0,0,0,0,0,0,0]

    if len(contours) > 0:
        cv2.drawContours(image, contours, -1, 255, 2)
        largestContour = max(contours, key=cv2.contourArea)
        rect = cv2.boxPoints(cv2.minAreaRect(largestContour))

        sorted_by_x = sorted(rect, key=lambda point: point[0])
        tl = sorted_by_x[0]
        br = sorted_by_x[3]

        sorted_by_y = sorted(rect, key=lambda point: point[1])
        tr = sorted_by_y[0]
        bl = sorted_by_y[3]

        width = np.linalg.norm(tr-tl)
        height = np.linalg.norm(tl-bl)

        angle = np.degrees(np.arctan((tl[1]-tr[1])/(tr[0]-tl[0])))

        if width<height:
            angle+=90

        if np.isnan(angle):
            angle = 90
        # print(int(angle),width,height)

        # cv2.rectangle(image,(x,y),(x+w,y+h),(0,255,255),2)
        llpython = [int(angle),llrobot[4],llrobot[5],0,0,0,0,0]
    # print(llpython)

    return largestContour, image, llpython